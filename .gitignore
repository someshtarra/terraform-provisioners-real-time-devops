# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH keys and sensitive assets
*.pem
*.key
*.pub
generated_keys/

# Execution plan files
tfplan
*.plan

# Local operational logs
*.log
local_audit.log
deployment_audit.log

# System files
.DS_Store
Thumbs.db
